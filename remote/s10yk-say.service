# 205 板 /etc/systemd/system/s10yk-say.service（2026-11-17 18:47 版，D-038）
# 与线上文件保持同步；线上备份：s10yk-say.service.bak.20261117
[Unit]
Description=S10 custom voice player (sayd) - single owner of plughw:0,0
After=sound.target

[Service]
Type=simple
Environment=SAYD_ALSA_DEV=plughw:0,0
Environment=SAYD_PORT=18081
Environment=SAYD_IDLE=1.2
# D-038：ES8323 上电默认 Speaker/Headphone 均为 off，厂商环境由 audio_node 负责打开；
# 我们弱化厂商栈后无人打开 → 播报/喊话全程无声。前缀 "-" 容错（amixer 失败不阻塞 sayd 启动）。
ExecStartPre=-/usr/bin/amixer -c 0 sset Speaker on
ExecStartPre=-/usr/bin/amixer -c 0 sset Headphone on
ExecStartPre=-/usr/bin/amixer -c 0 sset PCM 192
ExecStart=/usr/bin/python3 /opt/s10yk/sayd.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
